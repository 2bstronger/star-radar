# ============================================================
# 开源项目雷达 本地环境变量示例
# 复制为 .env 后填写，运行方式（node v22+ 原生支持 --env-file）：
#   node --env-file=.env scripts/fetch_stars.mjs
#   node --env-file=.env scripts/translate.mjs
# .env 已被 .gitignore 忽略，不会被提交。
# ============================================================

# 必填：GitHub 个人访问令牌（fine-grained PAT，仅需 Metadata: read + Starring: read）
# 用于 GraphQL 抓取 star 列表与 REST 拉取 README
GITHUB_TOKEN=

# 可选：LLM OpenAI 兼容接口地址（不配置 LLM_API_KEY 时翻译步骤自动跳过）
# 例如智谱：https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=

# 可选：LLM API Key，留空则跳过翻译
LLM_API_KEY=

# 可选：模型名，默认 glm-5.3-flash
LLM_MODEL=glm-5.3-flash
